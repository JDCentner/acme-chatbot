{
  "name": "acme-senior-living-demo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml --no-cache",
    "eval:view": "promptfoo view --port 15500",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "promptfoo": "^0.125.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
